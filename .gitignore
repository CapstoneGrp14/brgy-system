node_modules/
dist/
build/
coverage/
*.tsbuildinfo

.env
.env.local
.env.*.local
# Real production secrets (DB/RabbitMQ/MinIO passwords, JWT signing keys).
.env.production
# ...but keep the fill-in-the-blanks template tracked.
!.env.production.example

# runtime data
docker/data/
*.log

.DS_Store
.idea/
.vscode/
docs/

# `deploy/*` (not `deploy/`): git cannot re-include anything whose parent
# directory is excluded, so excluding the CONTENTS is what allows the nginx
# configs to stay tracked while certs/ stays out.
deploy/*
!deploy/nginx/
deploy/nginx/certs/