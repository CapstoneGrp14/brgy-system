# Copy to .env.production on the EC2 box and fill in. Never commit the real file.
#   cp .env.production.example .env.production && chmod 600 .env.production
#
# Generate every secret below with:  openssl rand -hex 32

# ─── Public DNS ─────────────────────────────────────────────────────────────
# These are the ONLY values tied to your Cloudflare records.
#
#   brgy591.site        -> host nginx -> SPA + /api + /socket.io  (api :3000)
#   api.brgy591.site    -> host nginx -> api :3000   (direct access; the SPA
#                          does NOT use this — it calls brgy591.site/api so the
#                          httpOnly refresh cookie is sent same-origin)
#   minio.brgy591.site  -> host nginx -> minio :9002
#
# WEB_URL is embedded in password-reset and staff-invite emails.
WEB_URL=https://brgy591.site
# Host that presigned file URLs are signed for. Must match the nginx server_name
# exactly — SigV4 covers the Host header, so a mismatch returns 403.
MINIO_PUBLIC_ENDPOINT=minio.brgy591.site
# MINIO_PUBLIC_PORT (443) and MINIO_PUBLIC_USE_SSL (true) are pinned in
# docker-compose.prod.yml; the internal endpoint stays plain http on the
# compose network.

# ─── Secrets ────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_openssl_rand_hex_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── MySQL (internal only — no published port) ──────────────────────────────
DB_NAME=brgy591
DB_USER=brgy
DB_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# ─── RabbitMQ (internal only) ───────────────────────────────────────────────
RABBITMQ_USER=brgy
RABBITMQ_PASSWORD=CHANGE_ME

# ─── MinIO credentials ──────────────────────────────────────────────────────
MINIO_ROOT_USER=brgy-minio
MINIO_ROOT_PASSWORD=CHANGE_ME

# ─── Mail ───────────────────────────────────────────────────────────────────
# Setting RESEND_API_KEY switches ALL outbound mail to Resend and the SMTP_*
# values are ignored. MAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM="Barangay 591 <no-reply@brgy591.site>"

# ─── 591 Assistant (Ollama) ─────────────────────────────────────────────────
# gemma3:1b runs on a small CPU-only instance; gemma3:4b needs ~4 GB free RAM.
# Set OLLAMA_URL= (empty) to drop to the rule-based assistant and skip the
# model download entirely — worth doing on a t3.small PoC.
OLLAMA_MODEL=gemma3:1b
