# Copy to .env and adjust as needed. Defaults match docker-compose.yml.

# --- API ---
API_PORT=3000
NODE_ENV=development
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=brgy
DB_PASSWORD=brgy_dev_password
DB_NAME=brgy591

# --- Redis ---
# Host port is 6380 in docker-compose (6379 is often taken by other local projects)
REDIS_URL=redis://localhost:6380

# --- RabbitMQ ---
# Host port is 5673 in docker-compose (management UI: http://localhost:15673)
RABBITMQ_URL=amqp://brgy:brgy_dev_password@localhost:5673

# --- MinIO ---
# Host port is 9002 in docker-compose (console: http://localhost:9003)
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=brgy-minio
MINIO_SECRET_KEY=brgy_dev_password
MINIO_BUCKET_UPLOADS=uploads
MINIO_BUCKET_DOCUMENTS=documents

# --- Gotenberg (docx → pdf conversion; host port 3010 in docker-compose) ---
GOTENBERG_URL=http://localhost:3010

# --- Mail ---
# Dev default: MailHog (catches everything at http://localhost:8025).
# Production: set RESEND_API_KEY below — one value switches all outbound mail
# to Resend; the SMTP_* vars are then ignored.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Barangay 591 <no-reply@brgy591.local>"

# --- Resend (production email) ---
# 1. Create an API key at https://resend.com/api-keys (starts with "re_").
# 2. Paste it below — that single value switches ALL outbound mail (host dev
#    AND docker compose) to Resend via smtp.resend.com:465. Leave empty for MailHog.
# 3. Set MAIL_FROM to an address on a domain verified in Resend
#    (https://resend.com/domains). Before verifying a domain you can test with
#    MAIL_FROM="Barangay 591 <onboarding@resend.dev>" (delivers only to your
#    own Resend account email while in test mode).
RESEND_API_KEY=

# --- 591 Assistant LLM (Ollama + Gemma 3) ---
# Docker compose starts Ollama and pulls OLLAMA_MODEL automatically.
# gemma3:4b = better answers (needs ~4 GB RAM) · gemma3:1b = fast on CPU-only.
# Empty OLLAMA_URL keeps the assistant rule-based. Containers get their URL
# from docker-compose; uncomment below only for host-run dev servers.
# OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b

# --- Web (Vite) ---
VITE_API_PROXY=http://localhost:3000
# Public URL of the web app (used in password-reset email links)
WEB_URL=http://localhost:5173
